# ---------------------------------------------------------------------------
# Lisans dogrulama servisi - ortam degiskenleri.
# Bu dosyayi kopyalayip ".env" adiyla kaydedin.
#
# ONEMLI: Bu, musteri uygulamasinin (.env dosyasindaki TURSO_DATABASE_URL)
# veritabanindan TAMAMEN AYRI bir veritabanidir. Bu servis KURUCUNUN kendi
# Vercel + Turso hesabinda barinir, musteri verisini asla tutmaz.
# ---------------------------------------------------------------------------

# Bu servisin kendi kucuk Turso veritabani (sadece lisans kayitlari).
# Bos birakilirsa yerel gelistirmede "licenses.db" dosyasi kullanilir.
LICENSES_DATABASE_URL=
LICENSES_AUTH_TOKEN=
