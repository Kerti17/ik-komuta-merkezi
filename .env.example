# ---------------------------------------------------------------------------
# IK Komuta Merkezi - ortam degiskenleri
# Bu dosyayi kopyalayip ".env" adiyla kaydedin ve degerleri doldurun.
# Her musteri kurulumu kendi ".env" dosyasina, kendi Supabase veritabanina sahiptir
# (bkz. talimat Bolum 2 - tek kiracili mimari).
# ---------------------------------------------------------------------------

# Supabase (Postgres) veritabani baglantisi (bkz. hata.md - Turso yerine gecildi,
# Turso'nun Windows'ta CLI kurulumu WSL gerektiriyordu).
# supabase.com'da proje olusturunca Settings -> Database -> Connection string
# altindaki URI'yi (tercihen "Transaction pooler", port 6543 - Vercel gibi
# serverless ortamlar icin onerilir) buraya yapistirin. Yerel gelistirmede de
# AYNI deger kullanilir - Turso'daki gibi otomatik yerel dosya fallback'i YOKTUR.
DATABASE_URL=

# /admin (NextAuth) VE /panel (paylasilan sifre cerezi) oturum sirlarini
# imzalamakta kullanilan ortak rastgele deger. Tanimlanmazsa yerel gelistirmede
# sabit, guvensiz bir varsayilana duser (konsolda uyari gorursunuz) - prod'da
# MUTLAKA doldurulmali. Uretmek icin: openssl rand -base64 32
AUTH_SECRET=

# Lisans dogrulama alt sistemi (bkz. talimat Bolum 7). LICENSE_API_URL, license-api/
# alt projesinin (ayri deploy edilir - bkz. license-api/README.md) Vercel adresidir.
# LICENSE_KEY, kurucudan satin alma sirasinda alinan anahtardir.
LICENSE_API_URL=
LICENSE_KEY=

# Destek formu / e-posta (bkz. talimat Bolum 9). Resend (resend.com) ucretsiz
# katmaniyla calisir. RESEND_API_KEY kurucunun kendi Resend hesabindan alinir.
# SUPPORT_EMAIL_TO kurucunun destek taleplerini almak istedigi adres.
# SUPPORT_EMAIL_FROM dogrulanmis bir alan adindan gonderim icin (bos birakilirsa
# Resend'in test gonderici adresi kullanilir - sadece Resend hesap sahibine gonderir).
RESEND_API_KEY=
SUPPORT_EMAIL_TO=
SUPPORT_EMAIL_FROM=
